# Supabase — from the project's API settings. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# First principal, read by the seed migration at deploy time (contract §1 "First user").
